{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/sso"
    },
    {
      "source": "/api/daily",
      "destination": "/api/sso?job=daily"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
