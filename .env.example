# Lokalnie: skopiuj do .env.local (plik nie trafia do repozytorium) i uruchom `vercel dev`.

# Supabase – TEN SAM projekt co Neutralizacja dokumentów (wspólna baza użytkowników).
NEXT_PUBLIC_SUPABASE_URL=https://edzjkumjutffodfpasmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz secret (service role) – tylko serwer: zakładanie kont, zaproszenia, uprawnienia
SUPABASE_SECRET_KEY=

# E-maile z zaproszeniami i resetem hasła (Resend)
RESEND_API_KEY=
# MAIL_FROM=Nutri APEX <no-reply@nutripartners.co>
# Adres w linkach z e-maili (domyślnie adres, pod który przyszło żądanie)
# APP_URL=https://nutripartners.vercel.app

# Adresy aplikacji na kafelkach i dla jednego logowania (domyślnie produkcyjne; w Preview wersje dev)
# VITE_NEUTRALIZER_URL=https://nutridocumentation-nxdi.vercel.app
# VITE_SIGNATURES_URL=https://nutri-signatures.vercel.app
# VITE_OWNER_LOOKUP_URL=https://whoisowner.vercel.app
# Tylko Preview: podglądy PR-ów, na które jedno logowanie może wrócić (wyrażenie regularne na całe origin)
# VITE_SSO_PREVIEW_ORIGINS=https://(nutridocumentation-nxdi|whoisowner|nutri-signatures)-[a-z0-9-]+-nutri-partners\.vercel\.app
